JWT_SECRET=troque-por-um-segredo-forte
DATABASE_URL=postgresql://usuario:senha@localhost:5432/dular

# Auth.js — OBRIGATÓRIO. Sem isto o app nem sobe: `exigirAuthSecret`
# (src/lib/authEnv.ts) lança na carga do módulo. Sem a chave o Auth.js entra em
# erro de configuração e `auth()` passa a devolver um objeto truthy — qualquer
# checagem escrita como `if (session)` aceitaria toda requisição.
# Gere com: openssl rand -base64 32
AUTH_SECRET=troque-por-um-segredo-forte
NEXTAUTH_SECRET=troque-por-um-segredo-forte

NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth — pelo menos UM provider completo é obrigatório (`exigirAlgumProvider`).
# O app entra só por Google e Apple; sem nenhum dos dois, /api/auth/session
# responde 500. O painel admin NÃO depende disto: ele autentica por JWT próprio,
# então dá para trabalhar no /admin com estas duas vazias.
# Redirect a registrar no Google Console: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple, alternativa à Google — dois caminhos possíveis:
#   dinâmico: APPLE_CLIENT_ID (ou APPLE_ID) + APPLE_TEAM_ID + APPLE_KEY_ID + APPLE_PRIVATE_KEY
#   legado:   APPLE_CLIENT_ID + APPLE_SECRET (JWT pré-assinado)

# Banco DESCARTÁVEL que o Prisma cria, usa e apaga para replicar as migrations
# e comparar com o schema. É o que `prisma migrate dev` e
# `prisma migrate diff --from-migrations` precisam — sem ele, o Prisma 7 recusa
# esses comandos em vez de rodar.
#
# Pode ficar vazio: só é necessário para quem vai GERAR migration. Aponte para
# um banco vazio no mesmo servidor, NUNCA para o banco de desenvolvimento —
# o Prisma apaga o conteúdo dele.
SHADOW_DATABASE_URL=

# Stripe — assinatura do profissional (somente DIARISTA/MONTADOR; ver auditoria/00-fonte-unica-verdade.md).
# O Empregador NUNCA paga. Sem estas chaves, checkout e webhook retornam erro (billing fica inerte).
STRIPE_SECRET_KEY=sk_test_troque-por-sua-chave
STRIPE_WEBHOOK_SECRET=whsec_troque-por-seu-segredo-de-webhook
