generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPREGADOR
  DIARISTA
  MONTADOR
  ADMIN
}

enum Genero {
  MASCULINO
  FEMININO
}

enum UserStatus {
  ATIVO
  BLOQUEADO
  /// Conta excluída a pedido do titular (LGPD). Os dados pessoais foram
  /// anonimizados; serviços, avaliações e incidentes seguem preservados e
  /// desvinculados, como promete a política de privacidade.
  REMOVIDO
}

enum VerificacaoStatus {
  PENDENTE
  VERIFICADO
  REPROVADO
}

enum SafetyEventType {
  CHECKIN_OK
  SOS_SILENT
}

/// Andamento do atendimento de um SOS no painel. Nulo em check-ins e nos SOS
/// gravados antes desta coluna existir; o painel mostra esses SOS como ACIONADO.
enum SafetyEventStatus {
  ACIONADO
  EM_ATENDIMENTO
  RESOLVIDO
}

enum IncidentType {
  ASSEDIO
  IMPORTUNACAO
  VIOLENCIA
  AMEACA
  OUTRO
}

enum IncidentStatus {
  ABERTO
  EM_ANALISE
  CONFIRMADO
  ENCERRADO
}

enum IncidentSeverity {
  BAIXA
  MEDIA
  ALTA
}

enum IncidenteCategoria {
  AGRESSAO_VERBAL
  AGRESSAO_FISICA
  AGRESSAO_PSICOLOGICA
  AGRESSAO_EMOCIONAL
  VIOLENCIA_SEXUAL
  IMPORTUNACAO_SEXUAL
  FURTO
  DANO_MATERIAL
  AMBIENTE_INSALUBRE
  VIOLACAO_PRIVACIDADE
  NO_SHOW
  OUTRO
}

enum IncidenteGravidade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum IncidenteResolucao {
  CONFIRMADA
  ARQUIVADA
  EM_ANALISE
  AGUARDANDO_EVIDENCIA
}

enum ScoreEventoTipo {
  AVALIACAO_POSITIVA
  AVALIACAO_NEGATIVA
  SERVICO_CONCLUIDO
  KYC_APROVADO
  KYC_REJEITADO
  DENUNCIA_CONFIRMADA
  DENUNCIA_ARQUIVADA
  CANCELAMENTO
  NO_SHOW
  TEMPO_PLATAFORMA
}

enum Turno {
  MANHA
  TARDE
}

enum ServicoTipo {
  FAXINA
  BABA
  COZINHEIRA
  PASSA_ROUPA
  MONTADOR
  FAXINEIRA
  LAVADEIRA
  CUIDADORA
}

enum ServicoCategoria {
  FAXINA_LEVE
  FAXINA_PESADA
  FAXINA_COMPLETA
  BABA_DIURNA
  BABA_NOTURNA
  BABA_INTEGRAL
  COZINHEIRA_DIARIA
  COZINHEIRA_EVENTO
  PASSA_ROUPA_BASICO
  PASSA_ROUPA_COMPLETO
  MONTADOR_MONTAGEM
  MONTADOR_REPAROS
  MONTADOR_ELETRICA
  MONTADOR_HIDRAULICA
  MONTADOR_PINTURA
  MONTADOR_CARPINTARIA
}

enum ServicoStatus {
  RASCUNHO
  SOLICITADO
  ACEITO
  RECUSADO
  CANCELADO
  EM_ANDAMENTO
  AGUARDANDO_FINALIZACAO
  CONCLUIDO
  CONFIRMADO
  FINALIZADO
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

enum MessageType {
  TEXT
  IMAGE
  LOCATION
  SYSTEM
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
}

/**
 * De onde veio a assinatura. Sem isto não dá para saber a quem perguntar o
 * estado de um assinante: renovação e cancelamento chegam por canais
 * diferentes (webhook do Stripe, App Store Server Notifications, Google RTDN),
 * e tratar um aviso da loja errada é pior do que não tratar.
 */
enum SubscriptionProvider {
  STRIPE
  APPLE
  GOOGLE
  /** Concedida na mão pelo admin — não tem loja para consultar. */
  MANUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELED
  EXPIRED
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
}

enum FeatureKey {
  SOLICITACOES_MES
  CHAT_ATIVO
  HISTORICO_COMPLETO
  SUPORTE_PRIORITARIO
}

enum FavoritoTipo {
  DIARISTA
  MONTADOR
}

model User {
  id             String        @id @default(cuid())
  nome           String
  telefone       String?       @unique
  cpf            String?       @unique
  dataNascimento DateTime?
  genero         Genero?
  email          String?       @unique
  senhaHash      String?
  role           UserRole?
  status         UserStatus    @default(ATIVO)

  /// Conta de demonstração para a revisão das lojas (App Store / Google Play).
  ///
  /// O revisor precisa CRIAR fluxos, não só olhar telas — e hoje dois portões
  /// o impedem: o KYC depende de aprovação humana, e o endereço precisa estar
  /// num bairro cadastrado (a operação é de uma cidade só).
  ///
  /// Esta flag abre exatamente esses dois portões, e nada além. Não concede
  /// admin, não pula autenticação, não libera plano pago.
  ///
  /// É por USUÁRIO, e não por variável de ambiente, de propósito: uma env
  /// ligada por engano em produção abriria o KYC de TODO MUNDO — é o que faz
  /// `AUTO_VERIFY_PROFILES` (lib/autoVerificacao.ts), que existe para E2E e
  /// não serve para isto. Aqui, o raio de dano é a própria conta.
  ///
  /// Nenhuma rota escreve neste campo. Só o seed `prisma/seed-demo.ts`.
  contaDemo      Boolean       @default(false)
  scoreAtual     Float         @default(500)
  riskScore      Float         @default(0)
  /// Tier de CONFIANÇA (PLATINUM = mais confiável). Único escritor:
  /// lib/safeScore/applyEvent.ts. Não é faixa de risco — ver `riskBand`.
  riskTier       SafeScoreTier @default(BRONZE)
  /// Faixa de RISCO por incidentes (CRITICO = mais risco), derivada de
  /// `riskScore`. Único escritor: lib/risk.ts. Nulo até o primeiro recálculo.
  riskBand       RiskBand?
  emObservacao   Boolean       @default(false)
  avatarUrl      String?
  pushToken      String?
  /** Último heartbeat do usuário (presença "online / visto por último"). */
  lastSeenAt     DateTime?

  /// Quando esta CONTA viu a apresentação do Premium (paywall de primeiro
  /// acesso). Nulo = ainda não viu.
  ///
  /// Mora aqui, e não em `Subscription`, porque a assinatura pode não existir
  /// (`findUnique` devolve null para quem nunca assinou) e a marca precisa
  /// valer desde o primeiro login. Sendo do usuário, sobrevive a fechar o app,
  /// a logout/login, a troca de aparelho e a reinstalação — o que um flag em
  /// memória ou em AsyncStorage não faz.
  ///
  /// Único escritor em runtime: POST /api/me/subscription/claim-intro, que
  /// grava com `updateMany ... where premiumIntroShownAt: null` para que duas
  /// chamadas simultâneas não reivindiquem a mesma apresentação duas vezes.
  ///
  /// A migration que criou a coluna também escreveu nela, uma vez só: marcou
  /// como vista toda conta que já existia. FIRST_LOGIN é de primeiro acesso, e
  /// quem já usava o app não está no primeiro acesso. Por isso o nulo só
  /// aparece em conta criada DEPOIS da migration — é o que a torna elegível.
  ///
  /// NÃO é gate de acesso nem concede benefício: só decide se uma tela de
  /// apresentação aparece. O bloqueio por plano continua em `featureGate`.
  premiumIntroShownAt DateTime?

  empregadorPerfil      EmpregadorPerfil?
  diaristaProfile       DiaristaProfile?
  montadorPerfil        MontadorPerfil?
  safeScore             SafeScore?
  safeScoreProfile      SafeScoreProfile?
  documentVerifications DocumentVerification[]
  restrictions          UserRestriction[]
  servicosComoCliente   Servico[]              @relation("ServicoCliente")
  servicosComoDiarista  Servico[]              @relation("ServicoDiarista")
  servicosComoMontador  Servico[]              @relation("ServicoMontador")
  safetyEvents          SafetyEvent[]
  incidentsReported     IncidentReport[]       @relation("ReportedBy")
  incidentsReceived     IncidentReport[]       @relation("ReportedUser")
  habilidades           DiaristaHabilidade[]
  oauthAccounts         OAuthAccount[]
  chatMessages          ChatMessage[]
  chatRoomExclusoes     ChatRoomExclusao[]
  subscription          Subscription?
  creditWallet          CreditWallet?
  notifications         Notification[]
  feedbacks             Feedback[]
  empregadorFavoritos   EmpregadorFavorito[] @relation("EmpregadorFavoritos")
  profissionalFavoritado EmpregadorFavorito[] @relation("ProfissionalFavoritado")
  enderecos             EnderecoUsuario[]
  paymentInfo           PaymentInfo?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TipoEndereco {
  RESIDENCIAL
  EMPRESARIAL
}

model EnderecoUsuario {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo            TipoEndereco
  cep             String
  rua             String
  numero          String
  complemento     String?
  bairro          String
  cidade          String
  uf              String
  pontoReferencia String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
}

model EmpregadorPerfil {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cidade     String?
  estado     String?
  fotoPerfil String?
  ativo      Boolean @default(true)

  latitude                Float?
  longitude               Float?
  cidadeAtual             String?
  estadoAtual             String?
  bairroAtual             String?
  localizacaoPermitida    Boolean   @default(false)
  localizacaoAtualizadaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiaristaProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  verificacao VerificacaoStatus @default(PENDENTE)
  ativo       Boolean           @default(true)
  fotoUrl     String?
  docUrl      String?
  bio         String?

  precoLeve   Int
  precoMedio  Int @default(0)
  precoPesada Int

  notaMedia     Float @default(0)
  totalServicos Int   @default(0)

  servicosOferecidos String[] @default([])

  // Localização base
  cidade    String?
  estado    String?
  latitude  Float?
  longitude Float?

  // Geolocalização atual
  cidadeAtual             String?
  estadoAtual             String?
  bairroAtual             String?
  localizacaoPermitida    Boolean   @default(false)
  localizacaoAtualizadaEm DateTime?

  // Cobertura
  atendeTodaCidade  Boolean @default(false)
  raioAtendimentoKm Int?

  // Experiência
  anosExperiencia Int?

  // Preços multi-nicho (Decimal para alinhar com MontadorPerfil)
  precoBabaHora       Decimal? @db.Decimal(10, 2)
  precoCozinheiraBase Decimal? @db.Decimal(10, 2)
  // Nichos novos: valor base por categoria. Null = "a combinar".
  precoPassadeira     Decimal? @db.Decimal(10, 2)
  precoLavadeira      Decimal? @db.Decimal(10, 2)
  precoCuidadora      Decimal? @db.Decimal(10, 2)
  precoCuidadoraHora  Decimal? @db.Decimal(10, 2)
  taxaMinima          Decimal? @db.Decimal(10, 2)
  cobraDeslocamento   Boolean  @default(false)
  valorACombinar      Boolean  @default(false)
  observacaoPreco     String?

  // Portfolio
  portfolioFotos String[] @default([])

  bairros DiaristaBairro[]
  agenda  Disponibilidade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cidade, estado])
}

model MontadorPerfil {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio             String?
  especialidades  String[] @default([])
  anosExperiencia Int?
  cidade          String?
  estado          String?

  latitude                Float?
  longitude               Float?
  cidadeAtual             String?
  estadoAtual             String?
  bairroAtual             String?
  localizacaoPermitida    Boolean   @default(false)
  localizacaoAtualizadaEm DateTime?
  atendeTodaCidade        Boolean   @default(false)

  bairros           String[] @default([])
  raioAtendimentoKm Int?
  fotoPerfil        String?
  portfolioFotos    String[] @default([])

  precoBase         Decimal? @db.Decimal(10, 2)
  taxaMinima        Decimal? @db.Decimal(10, 2)
  cobraDeslocamento Boolean  @default(false)
  observacaoPreco   String?
  valorACombinar    Boolean  @default(true)

  // Preço por especialidade (substitui precoBase global na UI; precoBase/taxaMinima
  // ficam no banco por compat, sem uso). Formato:
  //   { [especialidadeId]: { preco: number(centavos)|null, aCombinar: boolean } }
  precosEspecialidades Json?

  documentoFrente String?
  documentoVerso  String?
  selfieDoc       String?

  verificado    Boolean @default(false)
  ativo         Boolean @default(true)
  rating        Float   @default(0)
  totalServicos Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bairro {
  id     String @id @default(cuid())
  nome   String
  cidade String
  uf     String

  diaristas DiaristaBairro[]

  @@unique([nome, cidade, uf])
  @@index([cidade, uf])
}

model DiaristaBairro {
  id         String @id @default(cuid())
  diaristaId String
  bairroId   String

  diarista DiaristaProfile @relation(fields: [diaristaId], references: [id], onDelete: Cascade)
  bairro   Bairro          @relation(fields: [bairroId], references: [id], onDelete: Cascade)

  @@unique([diaristaId, bairroId])
  @@index([bairroId])
  @@index([diaristaId])
}

model Disponibilidade {
  id         String          @id @default(cuid())
  diaristaId String
  diarista   DiaristaProfile @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  diaSemana Int
  turno     Turno
  ativo     Boolean @default(true)

  @@unique([diaristaId, diaSemana, turno])
  @@index([diaristaId])
}

model Servico {
  id     String        @id @default(cuid())
  status ServicoStatus @default(SOLICITADO)

  tipo      ServicoTipo
  categoria ServicoCategoria?
  data      DateTime
  turno     Turno
  // Horário escolhido pelo empregador, "HH:MM" (ex.: "10:00"). `data` é
  // data-pura em meia-noite UTC (ver parseDataServico no mobile) e `turno` é
  // grosso demais: o app oferecia 6 horários, o empregador confirmava "às
  // 10:00" e o profissional só via "Manhã". String em vez de DateTime para
  // não reintroduzir fuso num campo que é local por natureza.
  // Opcional: serviços criados antes desta coluna não têm horário.
  hora      String?

  cidade String
  uf     String
  bairro String

  enderecoCompleto String?
  observacoes      String?

  temPet         Boolean @default(false)
  quartos3Mais   Boolean @default(false)
  banheiros2Mais Boolean @default(false)

  precoFinal Int

  // ── Pagamento PIX (P2P: empregador paga o profissional; a Dular não recebe) ──
  // O valor do PIX é SEMPRE precoFinal, congelado — nunca editável, nunca
  // vindo do cliente. Timestamps registram a linha do tempo do pagamento.
  paymentStatus      PaymentStatus @default(WAITING_PAYMENT)
  paymentReportedAt  DateTime?
  paymentConfirmedAt DateTime?
  paymentDisputedAt  DateTime?

  // Reagendamento com aprovação: o profissional propõe nova data/turno e o
  // empregador (client) confirma ou recusa. reagendamentoData != null = proposta pendente.
  reagendamentoData  DateTime?
  reagendamentoTurno Turno?
  reagendamentoHora  String?
  reagendamentoPor   String?
  reagendamentoEm    DateTime?

  clientId   String
  // diaristaId é opcional: serviços do tipo MONTADOR não têm diarista.
  // O campo permanece para preservar dados existentes (todos os serviços
  // criados antes do T-06 têm diaristaId não-nulo).
  diaristaId String?
  // montadorId é setado apenas em serviços com tipo === MONTADOR.
  // Aponta para User.id (mesmo padrão do diaristaId).
  montadorId String?

  cliente  User  @relation("ServicoCliente", fields: [clientId], references: [id], onDelete: Restrict)
  diarista User? @relation("ServicoDiarista", fields: [diaristaId], references: [id], onDelete: Restrict)
  montador User? @relation("ServicoMontador", fields: [montadorId], references: [id], onDelete: Restrict)

  avaliacao           Avaliacao?
  avaliacaoEmpregador AvaliacaoEmpregador?
  eventos             ServicoEvento[]
  paymentEvents       PaymentEvent[]
  pixSnapshot         PixSnapshot?
  chatRoom            ChatRoom?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([data, turno])
  @@index([status])
  @@index([cidade, uf, bairro])
  @@index([diaristaId])
  @@index([montadorId])
  @@index([clientId])
}

model DiaristaHabilidade {
  id         String            @id @default(cuid())
  diaristaId String
  tipo       ServicoTipo
  categoria  ServicoCategoria?
  createdAt  DateTime          @default(now())

  diarista User @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@unique([diaristaId, tipo, categoria])
  @@index([tipo, categoria])
  @@index([diaristaId])
}

enum PaymentStatus {
  WAITING_PAYMENT
  PAYMENT_REPORTED
  PAYMENT_CONFIRMED
  PAYMENT_DISPUTED
}

enum PixKeyType {
  CPF
  CELULAR
  EMAIL
  ALEATORIA
}

enum PaymentEventType {
  PIX_GENERATED
  PIX_COPIED
  PAYMENT_REPORTED
  PAYMENT_CONFIRMED
  PAYMENT_DISPUTED
}

// Dados de recebimento PIX do profissional (entidade própria, 1:1 com User —
// não são campos soltos na tabela User). A chave é usada pelo backend para
// montar o BR Code e nunca aparece completa em logs.
model PaymentInfo {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pixType    PixKeyType
  pixKey     String
  bank       String?
  holderName String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// Snapshot IMUTÁVEL dos dados de recebimento do serviço, congelado na
// contratação (aceite) — ou no primeiro uso, quando o profissional cadastra a
// chave depois de aceitar. Pertence ao ticket: alterações futuras no
// PaymentInfo do profissional NUNCA afetam pagamentos deste serviço.
// Create-only: nenhuma rota faz update/delete deste registro.
model PixSnapshot {
  id         String     @id @default(cuid())
  servicoId  String     @unique
  servico    Servico    @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  pixType    PixKeyType
  pixKey     String
  bank       String?
  holderName String
  createdAt  DateTime   @default(now())
}

// Trilha de auditoria do pagamento (espelha o padrão de ServicoEvento, mas
// com tipos próprios — transições de pagamento não são ServicoStatus).
model PaymentEvent {
  id        String           @id @default(cuid())
  servicoId String
  servico   Servico          @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  tipo      PaymentEventType
  actorId   String
  actorRole UserRole
  motivo    String?
  createdAt DateTime         @default(now())

  @@index([servicoId])
  @@index([actorId])
}

model ServicoEvento {
  id          String        @id @default(cuid())
  servicoId   String
  servico     Servico       @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  fromStatus  ServicoStatus
  toStatus    ServicoStatus
  actorRole   UserRole
  actorId     String
  motivo      String?
  observacao  String?
  motivoGrave Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([servicoId])
  @@index([actorId])
}

model Avaliacao {
  id        String  @id @default(cuid())
  servicoId String  @unique
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  clientId   String
  // Aponta para User.id do profissional avaliado. Para serviços de
  // DIARISTA usa-se diaristaId; para MONTADOR usa-se montadorId.
  // Mantemos diaristaId opcional para preservar dados existentes.
  diaristaId String?
  montadorId String?

  notaGeral    Int
  pontualidade Int
  qualidade    Int
  comunicacao  Int
  comentario   String?

  createdAt DateTime @default(now())

  @@index([diaristaId])
  @@index([montadorId])
  @@index([clientId])
}

// Avaliação na direção inversa: o profissional (DIARISTA/MONTADOR) avalia o
// EMPREGADOR. Mantida como modelo separado de `Avaliacao` (em vez de uma
// coluna de direção) para preservar 100% a relação 1:1 `Servico.avaliacao`
// existente e todos os seus leitores. Migration puramente aditiva.
model AvaliacaoEmpregador {
  id        String  @id @default(cuid())
  servicoId String  @unique
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  // Plain String (sem @relation), espelhando o padrão de `Avaliacao`.
  // profissionalId = autor (User.id do diarista/montador);
  // empregadorId = avaliado (User.id do cliente do serviço).
  profissionalId String
  empregadorId   String

  notaGeral    Int
  pontualidade Int
  qualidade    Int
  comunicacao  Int
  comentario   String?

  createdAt DateTime @default(now())

  @@index([empregadorId])
  @@index([profissionalId])
}

model SafetyEvent {
  id        String          @id @default(cuid())
  type      SafetyEventType
  userId    String
  serviceId String?
  lat       Float?
  lng       Float?
  meta      Json?
  createdAt DateTime        @default(now())

  /// Só SOS_SILENT: quem grava o SOS preenche ACIONADO, e o admin muda pelo
  /// painel. Nulo em check-ins e nos SOS anteriores à coluna.
  status                SafetyEventStatus?
  statusAtualizadoEm    DateTime?
  /// Admin que mudou o status por último. Sem relação: o histórico fica no AuditLog.
  statusAtualizadoPorId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, status, createdAt])
}

model IncidentReport {
  id             String              @id @default(cuid())
  reportedById   String
  reportedUserId String
  serviceId      String?
  type           IncidentType
  severity       IncidentSeverity    @default(MEDIA)
  categoria      IncidenteCategoria  @default(OUTRO)
  subtipo        String?
  gravidade      IncidenteGravidade  @default(MEDIA)
  resolucao      IncidenteResolucao?
  anonimo        Boolean             @default(false)
  description    String
  status         IncidentStatus      @default(ABERTO)

  attachments IncidentAttachment[]

  reportedBy   User @relation("ReportedBy", fields: [reportedById], references: [id])
  reportedUser User @relation("ReportedUser", fields: [reportedUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportedUserId])
  @@index([status])
}

model SafeScore {
  id        String        @id @default(cuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id])
  score     Int           @default(500)
  updatedAt DateTime      @updatedAt
  eventos   ScoreEvento[]
}

model ScoreEvento {
  id           String          @id @default(cuid())
  safeScoreId  String
  safeScore    SafeScore       @relation(fields: [safeScoreId], references: [id])
  tipo         ScoreEventoTipo
  peso         Int
  descricao    String?
  referenciaId String?
  /// Identidade do fato: `${tipo}:${referenciaId ?? "sem-ref"}` — a mesma convenção
  /// da chave de idempotência do V2. Única por SafeScore: o legado não conta duas
  /// vezes o mesmo fato. Linhas anteriores à constraint receberam `legado:<id>`.
  chaveIdempotencia String
  createdAt    DateTime        @default(now())

  @@unique([safeScoreId, chaveIdempotencia])
  @@index([safeScoreId])
  @@index([tipo])
  @@index([referenciaId])
}

model IncidentAttachment {
  id         String   @id @default(cuid())
  incidentId String
  key        String
  mime       String
  size       Int
  createdAt  DateTime @default(now())

  incident IncidentReport @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model OAuthAccount {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   OAuthProvider
  providerId String
  email      String?
  createdAt  DateTime      @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

model ChatRoom {
  id        String   @id @default(cuid())
  servicoId String   @unique
  servico   Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages  ChatMessage[]
  exclusoes ChatRoomExclusao[]
}

/// Conversa ARQUIVADA que um participante tirou da própria lista. Só vale
/// para quem excluiu: o outro participante, as mensagens, o serviço e as
/// avaliações não mudam. Uma linha por (sala, participante).
model ChatRoomExclusao {
  id        String   @id @default(cuid())
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  roomId    String
  room      ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User        @relation(fields: [senderId], references: [id])
  content   String
  type      MessageType @default(TEXT)
  deliveredAt DateTime?
  readAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([roomId, createdAt])
  @@index([senderId])
}

enum FeedbackTipo {
  SUGESTAO
  PROBLEMA
  ELOGIO
  OUTRO
}

/// Opinião da pessoa sobre o APP — não sobre quem prestou o serviço.
///
/// `Avaliacao` e `AvaliacaoEmpregador` avaliam a pessoa do outro lado e ficam
/// atreladas a um serviço. Isto aqui é o canal que faltava: quem quer sugerir,
/// reclamar do app ou avisar de um bug não tinha para onde escrever — o Suporte
/// é FAQ + WhatsApp e não grava nada, e "Reportar incidente" é denúncia formal
/// sobre conduta de alguém. Misturar os três num lugar só faria a operação
/// perder de vista qual é qual.
///
/// `onDelete: Cascade` de propósito: feedback não deve segurar a exclusão de uma
/// conta. Uma FK RESTRICT aqui entraria na fila que já trava o DELETE de `User`
/// (Servico, IncidentReport, SafeScore, ChatMessage) e cobraria o preço na
/// próxima limpeza de base.
model Feedback {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo   FeedbackTipo @default(SUGESTAO)

  /// 1–5 quando a pessoa quis dar nota. Nulo quando ela só escreveu — a nota é
  /// opcional para não transformar um desabafo em formulário.
  nota     Int?
  mensagem String

  /// De qual tela o formulário foi aberto. Sem isto, "não consigo pagar" chega
  /// sem dizer onde a pessoa estava quando desistiu.
  origem     String?
  /// Versão e plataforma separam "bug da 1.4.2 no Android" de "sempre foi assim".
  appVersao  String?
  plataforma String?

  /// Marcado quando alguém do time leu. Nulo = ainda na fila.
  lidoEm    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([tipo, createdAt])
  @@index([userId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  servicoId  String?
  chatRoomId String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Este model tem um índice que NÃO está declarado abaixo:
///
///   CREATE UNIQUE INDEX "Subscription_provider_externalId_key"
///     ON "Subscription" ("provider", "externalId")
///     WHERE "externalId" IS NOT NULL;
///
/// Origem: migration 20260909120000_subscription_provider.
/// Para que serve: impedir que o MESMO recibo de compra de loja (`externalId`)
/// ative plano em duas contas diferentes.
///
/// Por que não está no schema: a sintaxe do Prisma não representa índice
/// PARCIAL (a cláusula `WHERE`). E o `WHERE` é obrigatório — sem ele o índice
/// passaria a exigir `externalId` único entre TODAS as linhas, inclusive as
/// nulas, e barraria todo usuário que ainda não assinou. Declarar sem a
/// condição não é uma aproximação: é outro índice, e quebra o cadastro.
///
/// O que isso NÃO significa: o Prisma não remove este índice. Foi verificado —
/// `migrate diff` entre as migrations aplicadas e este schema devolve vazio,
/// porque índice parcial está fora do modelo interno do Prisma. Ele não
/// gerencia e, por não gerenciar, também não apaga.
///
/// O risco real é outro: alguém apagar o índice à mão ao escrever SQL cru numa
/// migration futura — coisa que este projeto faz com frequência. Contra isso há
/// `scripts/check-partial-index.mjs`, que roda no CI e recusa qualquer migration
/// com DROP INDEX sobre ele.
model Subscription {
  id         String             @id @default(cuid())
  userId     String             @unique
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan   @default(FREE)
  status     SubscriptionStatus @default(TRIAL)
  startedAt  DateTime           @default(now())
  expiresAt  DateTime?
  canceledAt DateTime?

  provider SubscriptionProvider @default(STRIPE)
  /** id da assinatura no provedor: `sub_...` no Stripe, originalTransactionId
   *  na Apple, purchaseToken no Google. Único por provedor. */
  externalId String?
  /** id do produto na loja (ex.: `br.com.dular.pro.mensal`). Nulo no Stripe,
   *  onde o preço vai inline na sessão de checkout. */
  storeProductId String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status])
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CreditTransaction[]
}

model CreditTransaction {
  id          String          @id @default(cuid())
  walletId    String
  wallet      CreditWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Int
  description String?
  servicoId   String?
  /// Sessão de checkout do Stripe que originou o crédito (`cs_…`). Única: é o
  /// que impede creditar duas vezes a mesma compra quando o webhook repete a
  /// entrega. Nula nos lançamentos que não vêm do Stripe.
  stripeCheckoutSessionId String? @unique
  createdAt   DateTime        @default(now())

  @@index([walletId])
  @@index([servicoId])
}

model FeatureLimit {
  id      String           @id @default(cuid())
  plan    SubscriptionPlan
  feature FeatureKey
  limit   Int?
  enabled Boolean          @default(true)

  @@unique([plan, feature])
}

// ==========================================
// SAFESCORE GUARDIÃO — FASE 1
// ==========================================

enum SafeScoreTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

/// Faixa de risco por incidentes (lib/risk.ts). Semântica oposta à de
/// SafeScoreTier: aqui o último valor é o PIOR. Enum próprio para que as duas
/// escalas não possam ser gravadas uma no lugar da outra.
enum RiskBand {
  BAIXO
  MEDIO
  ALTO
  CRITICO
}

enum DocumentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRestrictionType {
  SHADOW_BAN
  LIMIT_BOOKINGS
  SUSPEND
  BLOCK
}

model SafeScoreProfile {
  id           String           @id @default(cuid())
  userId       String           @unique
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentScore Float            @default(500)
  riskScore    Float            @default(0)
  tier         SafeScoreTier    @default(BRONZE)
  lastRecalcAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  events       SafeScoreEvent[]
}

model SafeScorePolicyVersion {
  id           String           @id @default(cuid())
  version      String           @unique
  weights      Json
  publishedAt  DateTime         @default(now())
  deprecatedAt DateTime?
  events       SafeScoreEvent[]
}

model SafeScoreEvent {
  id              String                 @id @default(cuid())
  idempotencyKey  String                 @unique
  userId          String
  profile         SafeScoreProfile       @relation(fields: [userId], references: [userId], onDelete: Restrict)
  policyVersionId String
  policyVersion   SafeScorePolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  scoreBefore     Float
  scoreAfter      Float
  delta           Float
  eventType       String
  source          String
  sourceId        String?
  actorId         String?
  payload         Json?
  createdAt       DateTime               @default(now())

  @@index([userId])
  @@index([idempotencyKey])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  targetId   String
  targetType String
  action     String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
}

model DocumentVerification {
  id         String                     @id @default(cuid())
  userId     String
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType    String
  docUrl     String
  status     DocumentVerificationStatus @default(PENDING)
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  @@index([userId])
}

model UserRestriction {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserRestrictionType
  reason    String
  expiresAt DateTime?
  createdBy String
  revokedAt DateTime?
  createdAt DateTime            @default(now())

  @@index([userId])
}

model EmpregadorFavorito {
  id                 String   @id @default(cuid())
  empregadorUserId   String
  profissionalUserId String
  tipo               FavoritoTipo
  createdAt          DateTime @default(now())

  empregador         User     @relation("EmpregadorFavoritos", fields: [empregadorUserId], references: [id], onDelete: Cascade)
  profissional       User     @relation("ProfissionalFavoritado", fields: [profissionalUserId], references: [id], onDelete: Cascade)

  @@unique([empregadorUserId, profissionalUserId, tipo])
  @@index([empregadorUserId])
  @@index([profissionalUserId])
}
